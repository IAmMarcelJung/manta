from amaranth import *
from serial import Serial

from manta.usb.usb_source_bridge import USBSourceBridge
from manta.usb.usb_sink_bridge import USBSinkBridge
from manta.utils import *


class USBCDCInterface(Elaboratable):
    """
    A synthesizable module for USB CDC communication between a host machine and
    the FPGA.
    """

    def __init__(self, port, fifo_depth=16):
        """
        This function is the main mechanism for configuring a USB CDC Interface
        in an Amaranth-native design.

        Args:
            port (str): The name of the serial port on the host machine that's
                connected to the FPGA. For USB CDC devices, this will typically
                be `/dev/ttyACMXX` on Linux/Mac or `COMX` on Windows.

            fifo_depth (Optional[int]): The depth of the FIFO buffer used to handle
                backpressure from the USB CDC interface. Increase this if you're
                experiencing data loss.

        Raises:
            ValueError: The port is invalid or not provided.
        """

        self._port = port
        self._fifo_depth = fifo_depth
        self._check_config()

        # Top-Level Ports - USB CDC Interface
        self.from_usb_data_i = Signal(8)  # Data from USB to FPGA
        self.from_usb_data_valid_i = Signal()  # Data valid signal from USB
        self.from_usb_data_ready_o = Signal()  # Ready to accept data signal to USB

        self.to_usb_data_o = Signal(8)  # Data from FPGA to USB
        self.to_usb_data_valid_o = Signal()  # Data valid signal to USB
        self.to_usb_data_ready_i = Signal()  # Ready to accept data signal from USB

        # Manta internal bus
        self.bus_o = Signal(InternalBus())  # Output bus (USB to Manta)
        self.bus_i = Signal(InternalBus())  # Input bus (Manta to USB)

        # Handshaking signals
        self.bus_o_ready_i = Signal()  # Ready signal from downstream module
        self.bus_i_ready_o = Signal()  # Ready signal to upstream module

    @classmethod
    def from_config(cls, config):
        port = config.get("port")

        # Warn if unrecognized options have been given
        recognized_options = ["port", "fifo_depth"]
        for option in config:
            if option not in recognized_options:
                warn(
                    f"Ignoring unrecognized option '{option}' in USB CDC interface config."
                )

        return cls(**config)

    def to_config(self):
        return {
            "port": self._port,
            "fifo_depth": self._fifo_depth,
        }

    def _check_config(self):
        # Ensure a serial port has been given
        if self._port is None:
            raise ValueError("No serial port provided to USB CDC interface.")

    def _get_serial_device(self):
        """
        Return an open PySerial serial device if one exists, otherwise, open
        one and return it.
        """

        # Check if we've already opened a device
        if hasattr(self, "_serial_device"):
            return self._serial_device

        # We don't require baudrate for USB CDC devices, as they use the USB protocol
        # which has its own timing. However, PySerial still needs a baudrate parameter,
        # so we use a default value that doesn't really matter.
        DEFAULT_BAUDRATE = 115200

        try:
            self._serial_device = Serial(self._port, DEFAULT_BAUDRATE, timeout=1)
            return self._serial_device
        except Exception as e:
            raise ValueError(f"Failed to open USB CDC port {self._port}: {str(e)}")

    def get_top_level_ports(self):
        """
        Return the Amaranth signals that should be included as ports in the
        top-level Manta module.
        """
        return [
            self.from_usb_data_i,
            self.from_usb_data_valid_i,
            self.from_usb_data_ready_o,
            self.to_usb_data_o,
            self.to_usb_data_valid_o,
            self.to_usb_data_ready_i,
        ]

    def read(self, addrs):
        """
        Read the data stored in a set of address on Manta's internal memory.
        Addresses must be specified as either integers or a list of integers.
        """

        # Handle a single integer address
        if isinstance(addrs, int):
            return self.read([addrs])[0]

        # Make sure all list elements are integers
        if not all(isinstance(a, int) for a in addrs):
            raise TypeError("Read address must be an integer or list of integers.")

        ser = self._get_serial_device()
        data = []

        for addr in addrs:
            # Format: 1-byte command (R=0x52) followed by 2-byte address
            cmd_bytes = bytearray([0x52, (addr >> 8) & 0xFF, addr & 0xFF])
            ser.write(cmd_bytes)

            # Read response: 2 bytes of data
            response = ser.read(2)
            if len(response) != 2:
                raise ValueError(f"Expected 2 bytes in response, got {len(response)}")

            # Convert to integer
            value = (response[0] << 8) | response[1]
            data.append(value)

        return data

    def write(self, addrs, data):
        """
        Write the provided data into the provided addresses in Manta's internal
        memory. Addresses and data must be specified as either integers or a
        list of integers.
        """

        # Handle a single integer address and data
        if isinstance(addrs, int) and isinstance(data, int):
            return self.write([addrs], [data])

        # Make sure address and data are all integers
        if not isinstance(addrs, list) or not isinstance(data, list):
            raise TypeError(
                "Write addresses and data must be an integer or list of integers."
            )

        if not all(isinstance(a, int) for a in addrs):
            raise TypeError("Write addresses must be all be integers.")

        if not all(isinstance(d, int) for d in data):
            raise TypeError("Write data must all be integers.")

        ser = self._get_serial_device()

        for addr, value in zip(addrs, data):
            # Format: 1-byte command (W=0x57) followed by 2-byte address and 2-byte data
            cmd_bytes = bytearray(
                [
                    0x57,  # 'W'
                    (addr >> 8) & 0xFF,
                    addr & 0xFF,  # 16-bit address
                    (value >> 8) & 0xFF,
                    value & 0xFF,  # 16-bit data
                ]
            )
            ser.write(cmd_bytes)

    def elaborate(self, platform):
        m = Module()

        # Create USB CDC bridges
        m.submodules.source_bridge = source_bridge = USBSourceBridge()
        m.submodules.sink_bridge = sink_bridge = USBSinkBridge(
            fifo_depth=self._fifo_depth
        )

        # Connect USB CDC interface to bridges
        m.d.comb += [
            # USB CDC RX -> Internal Bus (Source Bridge)
            source_bridge.from_usb_data_i.eq(self.from_usb_data_i),
            source_bridge.from_usb_data_valid_i.eq(self.from_usb_data_valid_i),
            self.from_usb_data_ready_o.eq(source_bridge.from_usb_data_ready_o),
            source_bridge.bus_ready_i.eq(self.bus_o_ready_i),
            # Connect source bridge output to module output
            self.bus_o.eq(source_bridge.bus_o),
            # Internal Bus -> USB CDC TX (Sink Bridge)
            sink_bridge.bus_i.eq(self.bus_i),
            self.bus_i_ready_o.eq(sink_bridge.bus_ready_o),
            self.to_usb_data_o.eq(sink_bridge.to_usb_data_o),
            self.to_usb_data_valid_o.eq(sink_bridge.to_usb_data_valid_o),
            sink_bridge.to_usb_data_ready_i.eq(self.to_usb_data_ready_i),
        ]

        return m
